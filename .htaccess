# Velq current homepage, Journal, and existing waitlist backend
DirectoryIndex velq-site.php index.html
ErrorDocument 404 default

# Apply the current product-photo override to the bundled homepage response.
php_value auto_prepend_file image-patch.php

# Canonical host: www serves duplicate content, 301 it to the apex domain
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.velqnutrition\.com$ [NC]
  RewriteRule ^ https://velqnutrition.com%{REQUEST_URI} [L,R=301]

  # Serve the approved strawberry red-and-white product packshot anywhere the legacy product imagery is referenced.
  # Keep the old image URLs stable for the bundled homepage and social previews.
  RewriteRule ^assets/(?:velq-fruit-snacks-original\.jpg|velq-neutral-product\.png)$ https://cdn.shopify.com/s/files/1/0723/8372/5647/files/velq-red-white-strawberry-final-hero-oct-2026.jpg?v=1791934937 [R=302,L,NE,NC]

  # Keep the fiber gummies vs powder search landing page live; it now has a current buyer guide.
  RewriteRule ^blog/fiber-gummies-vs-fiber-powder(?:/|/index\.html)?$ /blog/fiber-gummies-vs-fiber-powder/index.html [END]

  # IndexNow verification file is stored in assets but must be served at the domain root.
  RewriteRule ^d1d335a0e252917f7c1345bb896190c265b2826baf993531\.txt$ /assets/d1d335a0e252917f7c1345bb896190c265b2826baf993531.txt [L]

  # Retired lemonade SKUs, including old collection-prefixed product URLs.
  RewriteRule ^(?:collections/[^/]+/)?products/(?:lemonade-protein-hydration-powder|velq-lemonade-protein-hydration-powder|elq-daily-protein-fiber-electrolytes-lemonade|velq-daily-protein-fiber-electrolytes-lemonade|velq-bundle|velq-lemonade-protein-hydration-powder-3-pack)(?:/|/index\.html)?$ - [G,L,NC]

  # Retire legacy powder-only pages while preserving the related snack guide.
  RewriteRule ^guides/protein-and-fiber-snacks-without-protein-powder(?:/|/index\.html)?$ /guides/protein-and-fiber-snacks [R=301,L,NE,NC]
  RewriteRule ^(?:products/lemonade-protein-hydration-powder|blog/(?:protein-gummies-vs-protein-powder)|guides/(?:can-you-mix-protein-and-electrolytes|how-to-mix-protein-powder-in-16-oz-of-water|why-does-clear-protein-foam|protein-powder-for-people-who-hate-shakes|what-is-protein-hydration-powder|protein-water-vs-protein-shakes|protein-powder-with-prebiotic-fiber|protein-drink-for-your-morning-routine))(?:/|/index\.html)?$ - [G,L,NC]
  RewriteRule ^Velq.Lemonade\.dc\.html$ - [G,L,NC]
  RewriteRule ^tools/snack-finder(?:/.*)?$ - [G,L]

  # Keep source control and build utilities outside the public site.
  RewriteRule ^(?:\.git|hostinger-migration|scripts|githooks)(?:/|$) - [F,L]

  # Route the current Site assets and APIs through its PHP bundle.
  RewriteRule ^(?:index\.html|tools(?:/.*)?|guides(?:/.*)?|blog(?:/.*)?|blogs/journal(?:/.*)?|(?:style|journal)\.css|(?:app|analytics|journal|analytics-config)\.js|api/waitlist|robots\.txt|sitemap\.xml)?$ velq-site.php [END]

  # Preserve existing legacy files; unknown URLs must return a real 404.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ velq-site.php [END]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
